{
  "manifest_version": 2,
  "name": "MDBird Search",
  "description": "__MSG_extension_description__",
  "version": "1.0.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "mdbird-search@mdbird.local",
      "strict_min_version": "159.0"
    }
  },
  "experiment_apis": {
    "mdbirdSearch": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["mdbirdSearch"]],
        "script": "search.js",
        "events": ["startup"]
      }
    }
  }
}
